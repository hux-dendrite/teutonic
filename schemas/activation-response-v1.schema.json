{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://teutonic.ai/schemas/activation-response-v1.schema.json",
  "title": "Teutonic activation response v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "signature_scheme",
    "registration_id",
    "hotkey",
    "validator_nonce",
    "signature"
  ],
  "properties": {
    "protocol_version": { "const": 1 },
    "signature_scheme": { "const": "ed25519" },
    "registration_id": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "hotkey": { "type": "string", "minLength": 40, "maxLength": 64 },
    "validator_nonce": { "type": "string", "minLength": 1, "maxLength": 128 },
    "signature": { "type": "string", "minLength": 64, "maxLength": 256 }
  }
}
