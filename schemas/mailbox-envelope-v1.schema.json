{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://teutonic.ai/schemas/mailbox-envelope-v1.schema.json",
  "title": "Teutonic decrypted credential mailbox envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "validator_identity",
    "netuid",
    "uid",
    "hotkey",
    "registration_id",
    "credential_generation",
    "r2_endpoint",
    "ingest_bucket",
    "allowed_prefix",
    "credential_scope",
    "revocation_event",
    "submission_policy",
    "access_key_id",
    "secret_access_key",
    "session_token",
    "expires_at",
    "validator_nonce",
    "signature_scheme",
    "validator_signature"
  ],
  "properties": {
    "protocol_version": { "const": 1 },
    "validator_identity": { "type": "string", "minLength": 40, "maxLength": 128 },
    "netuid": { "type": "integer", "minimum": 0 },
    "uid": { "type": "integer", "minimum": 0 },
    "hotkey": { "type": "string", "minLength": 40, "maxLength": 64 },
    "registration_id": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "credential_generation": { "type": "integer", "minimum": 1 },
    "r2_endpoint": { "type": "string", "format": "uri", "pattern": "^https://" },
    "ingest_bucket": { "type": "string", "minLength": 3, "maxLength": 63 },
    "allowed_prefix": { "type": "string", "pattern": "^ingest/[0-9a-f]{64}/$" },
    "credential_scope": { "const": "object-read-write" },
    "revocation_event": { "const": "finalized_ready_signal" },
    "submission_policy": { "const": "one_per_hotkey" },
    "access_key_id": { "type": "string", "minLength": 1 },
    "secret_access_key": { "type": "string", "minLength": 1 },
    "session_token": { "type": "string", "minLength": 1 },
    "expires_at": { "type": "string", "format": "date-time" },
    "validator_nonce": { "type": "string", "minLength": 1, "maxLength": 128 },
    "signature_scheme": { "const": "ed25519" },
    "validator_signature": { "type": "string", "minLength": 64, "maxLength": 256 }
  }
}
